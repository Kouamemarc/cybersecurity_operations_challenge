{
  "index_patterns": ["soc-*"],
  "template": {
    "settings": { "index.lifecycle.name": "soc-retention-7d" },
    "mappings": {
      "properties": {
        "source": { "properties": { "ip": { "type": "ip" }, "port": { "type": "integer" } } },
        "destination": { "properties": { "ip": { "type": "ip" }, "port": { "type": "integer" } } },
        "user": { "properties": { "name": { "type": "keyword" } } },
        "event": { "properties": { "action": { "type": "keyword" }, "outcome": { "type": "keyword" }, "dataset": { "type": "keyword" }, "code": { "type": "keyword" } } },
        "dns": { "properties": { "question": { "properties": { "name": { "type": "keyword" }, "name_length": { "type": "integer" } } } } },
        "host": { "properties": { "name": { "type": "keyword" } } }
      }
    }
  }
}
