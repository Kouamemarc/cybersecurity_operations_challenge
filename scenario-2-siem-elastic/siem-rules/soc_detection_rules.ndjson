{"author": ["Marc Bohoussou"], "from": "now-1h", "to": "now", "interval": "5m", "enabled": true, "version": 1, "license": "", "immutable": false, "tags": ["TechnoVision", "SOC-Scenario-2", "Detection-Engineering"], "max_signals": 100, "rule_id": "soc-ssh-bruteforce-success", "name": "Intrusion SSH réussie après bruteforce", "description": "Détecte une authentification SSH réussie sur le compte 'admin' (corrélé au bruteforce).", "type": "threshold", "language": "kuery", "query": "event.dataset : \"linux.auth\" and event.outcome : \"success\" and user.name : \"admin\"", "index": ["soc-linux-*"], "threshold": {"field": ["source.ip"], "value": 1}, "severity": "high", "risk_score": 73, "threat": [{"framework": "MITRE ATT&CK", "tactic": {"id": "TA0006", "name": "Credential Access", "reference": "https://attack.mitre.org/tactics/TA0006/"}, "technique": [{"id": "T1110", "name": "Brute Force", "reference": "https://attack.mitre.org/techniques/T1110/"}]}]}
