# Version de la stack Elastic — épingle une 8.x récente (8.15+).
# La 9.x existe mais la 8.x est le chemin le plus documenté pour ce projet.
STACK_VERSION=8.15.3

# Mots de passe (change-les !)
ELASTIC_PASSWORD=elk@1234
KIBANA_PASSWORD=kibana@1234

# Nom du cluster et port Kibana exposé
CLUSTER_NAME=technovision-soc
KIBANA_PORT=5601

# Port Elasticsearch exposé (nœud es01)
ES_PORT=9200

# Limite mémoire par conteneur ES (ajuste selon ton hôte)
MEM_LIMIT=1073741824

# Licence : basic (gratuite) — SIEM/detection rules dispo
LICENSE=basic
